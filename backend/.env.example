# Royal Square Financial backend — environment configuration.
# Copy to .env for local development. Production values come from AWS Secrets Manager.

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database (PostgreSQL 16) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=royalsquare
DB_USER=royalsquare
DB_PASSWORD=local_dev_only
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# ── Redis (cache / queues / token blacklist) ───────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth ────────────────────────────────────────────────────────────────────
# JWT_SECRET must be at least 32 characters. Generate a strong random value.
JWT_SECRET=change_me_to_a_long_random_value_at_least_32_chars
# Access token lifetime (short-lived); the refresh token below keeps sessions alive.
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=30d

# ── Encryption (application-level, envelope via KMS in prod) ─────────────────
# 32-byte key. For local dev a hex/base64 string is fine; in prod this is a KMS-wrapped DEK.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ── AWS — data residency: Cape Town (af-south-1) for POPIA §72 ───────────────
# NOTE: default region is af-south-1 (Cape Town), intentionally overriding the older
# doc default of us-east-1, to keep all client data in-region per POPIA Section 72.
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
CLOUDFRONT_DOMAIN=
KMS_KEY_ID=
KMS_MEDICAL_KEY_ID=
SECRETS_PREFIX=/royal-square/production

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Feature flags ────────────────────────────────────────────────────────────
ENABLE_MEDICAL_MODULE=false
ENABLE_CLAIMS_MODULE=false
ENABLE_INTEGRATION_SIMULATION=true

# ── Koisa (Amazon Bedrock) ───────────────────────────────────────────────────
BEDROCK_REGION=af-south-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5-20250929-v1:0
KOISA_ENABLED=true

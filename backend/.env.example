# Royal Square Financial backend — environment configuration.
# Copy to .env for local development. Production values come from AWS Secrets Manager.

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database (PostgreSQL 16) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=royalsquare
DB_USER=royalsquare
DB_PASSWORD=local_dev_only
DB_POOL_MIN=2
DB_POOL_MAX=10
# Production DB_SSL=true verifies the RDS certificate and hostname with the packaged AWS CA bundle.
DB_SSL=false

# ── Redis (cache / queues / token blacklist) ───────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
# none preserves local no-auth Redis. password preserves legacy static-password deployments.
# For password mode set REDIS_AUTH_MODE=password and REDIS_PASSWORD below.
# For AWS IAM mode use Redis OSS 7+, TLS, a username equal to the ElastiCache user ID, and set
# REDIS_IAM_RESOURCE to the lowercase replication-group ID (never the DNS endpoint).
REDIS_AUTH_MODE=none
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_IAM_RESOURCE=

# ── Auth ────────────────────────────────────────────────────────────────────
# JWT_SECRET must be at least 32 characters. Generate a strong random value.
JWT_SECRET=change_me_to_a_long_random_value_at_least_32_chars
# Access token lifetime (short-lived); the refresh token below keeps sessions alive.
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=30d

# ── Encryption (application-level, envelope via KMS in prod) ─────────────────
# 32-byte key. For local dev a hex/base64 string is fine; in prod this is a KMS-wrapped DEK.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ── AWS — data residency: Cape Town (af-south-1) for POPIA §72 ───────────────
# NOTE: default region is af-south-1 (Cape Town), intentionally overriding the older
# doc default of us-east-1, to keep all client data in-region per POPIA Section 72.
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Legacy document CloudFront domain only; keep it during the stage-one frontend rollout.
# Document upload/download authorization still uses direct, short-lived S3 presigned URLs.
# Do not set this to the separate frontend distribution domain.
CLOUDFRONT_DOMAIN=
KMS_KEY_ID=
KMS_MEDICAL_KEY_ID=
SECRETS_PREFIX=/royal-square/production

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Feature flags ────────────────────────────────────────────────────────────
ENABLE_MEDICAL_MODULE=false
ENABLE_CLAIMS_MODULE=false
ENABLE_INTEGRATION_SIMULATION=true

# ── Koisa (Amazon Bedrock) ───────────────────────────────────────────────────
# Disabled unless explicitly enabled. When enabled, region/model must be set and Bedrock must
# remain in AWS_REGION for POPIA residency. Credentials use the AWS SDK default provider chain.
KOISA_ENABLED=false
BEDROCK_REGION=af-south-1
BEDROCK_MODEL_ID=
KOISA_MAX_ROUNDS=4
KOISA_MAX_TOTAL_TOOL_CALLS=6
KOISA_MAX_PER_TOOL_CALLS=2
KOISA_OVERALL_TIMEOUT_MS=15000
KOISA_TOOL_TIMEOUT_MS=4000
KOISA_MAX_TOKENS=512
KOISA_MAX_TOOL_RESULT_BYTES=8192

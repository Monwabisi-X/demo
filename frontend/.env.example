# Base URL for the Royal Square backend API (v2.0.0).
# In dev, requests to /api are proxied to VITE_API_PROXY by vite.config.ts.
# Production static builds must override this with an absolute HTTPS URL, for example:
# VITE_API_URL=https://api.example.com/api/v1
VITE_API_URL=/api/v1
VITE_API_PROXY=http://localhost:3000

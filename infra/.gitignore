# Terraform working dirs / state — never commit.
.terraform/
*.tfstate
*.tfstate.*
crash.log

# Local variable files may contain environment specifics — commit only the .example.
terraform.tfvars
*.auto.tfvars

# Lambda build artifacts (regenerated by `archive_file` on plan/apply).
modules/api/build/

# Keep the provider lock file (.terraform.lock.hcl) committed for reproducible plans.

# Example variables. Copy to terraform.tfvars and adjust per environment.
# NEVER put secrets here (DB password, JWT secret, Smile ID key). Those live in AWS Secrets
# Manager and are injected out-of-band (GitHub Actions / manual). See infra/README.md.

region      = "af-south-1"
environment = "dev"
name_prefix = "rsf"

vpc_cidr = "10.20.0.0/16"
az_count = 2

# ── Cost toggles — everything defaults to the cheapest safe posture. ──────────────
# Turn these on deliberately, per environment, once you accept the cost.
enable_nat_gateway   = false # recurring hourly + data cost
# Interface endpoints are private but billable per service/AZ. Select only what the runtime uses.
enable_vpc_endpoints = true
interface_endpoint_services = [
  "ecr.api",
  "ecr.dkr",
  "secretsmanager",
  "kms",
  "logs",
  "ssm",
  "ssmmessages",
  "ec2messages",
  # Add "bedrock-runtime" when enable_koisa=true and NAT remains disabled.
]

# ── Koisa / Amazon Bedrock — disabled until every explicit value is reviewed. ──
enable_koisa    = false
bedrock_region  = "af-south-1" # must equal region when enabled; no cross-region fallback
bedrock_model_id = ""          # explicit model or inference-profile ID/ARN; no default
bedrock_invoke_resource_arns = [
  # "arn:aws:bedrock:af-south-1:123456789012:inference-profile/example-profile",
  # or an exact foundation-model ARN with an empty account segment
]
koisa_max_rounds            = 4
koisa_max_total_tool_calls  = 6
koisa_max_per_tool_calls    = 2
koisa_overall_timeout_ms    = 15000
koisa_tool_timeout_ms       = 4000
koisa_max_tokens            = 512
koisa_max_tool_result_bytes = 8192

enable_cloudfront         = true  # stage one: retain legacy document CloudFront/OAC state; KMS decrypt remains denied
# Separate static frontend origin/distribution. Enable only in stage one after a no-destroy plan.
enable_frontend_delivery  = false
enable_rds              = false # turn on to create the PostgreSQL instance
enable_container_registry = false # encrypted, immutable ECR backend repository
# After the repository exists, build and push the linux/arm64 backend image, then pin its digest:
# backend_image_uri = "123456789012.dkr.ecr.af-south-1.amazonaws.com/rsf/dev/backend@sha256:<64-lowercase-hex>"
enable_ec2_alb        = false # requires RDS, Redis, registry, image digest, and private egress
# Production compute must use HTTPS. The ACM certificate must be in the ALB region.
enable_https          = false
# alb_certificate_arn = "arn:aws:acm:af-south-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"
# api_domain_name     = "api.example.com"
# route53_zone_id     = "Z0000000000000000000"
cors_origin          = "http://localhost:5173"
log_retention_days   = 30
enable_api_lambda     = true  # API Gateway + Smile ID Lambda (pay-per-use)
enable_redis          = false # legacy ElastiCache cluster; keep true throughout the parallel rollout
# Add the encrypted Redis OSS 7.1 replication group without changing the selected endpoint.
enable_redis_tls      = false
# Do not set true until the IAM/TLS-capable JS client release is deployed and the cutover snapshot
# has been restored. This switches both EC2 and reminder Lambda environment wiring together.
use_redis_tls         = false
redis_tls_num_cache_clusters       = 2 # production-safe HA default; 1 is explicitly non-HA
redis_tls_snapshot_retention_days  = 7
redis_tls_initial_snapshot_name    = "" # set only for initial create after a quiesced manual snapshot
# Builds the repository-managed reminder Lambda and schedule. Before enabling: build the ZIP,
# enable RDS + the selected Redis deployment, and provide NAT or include "secretsmanager" above.
enable_scheduler = false
# When disabling an existing Scheduler, set this true in the same reviewed change so the
# encrypted DLQ and its failure evidence remain. Deleting the queue requires a later code change.
retain_reminder_dlq = false
reminder_lambda_artifact_path = "../backend/dist/reminder-lambda.zip"
enable_step_functions = false # claims lifecycle orchestration

# ── Sizing (Graviton/arm64, smallest sensible) ───────────────────────────────────
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
db_multi_az          = false
ec2_instance_type    = "t4g.micro"
redis_node_type      = "cache.t4g.micro"

db_name     = "royalsquare"
db_username = "royalsquare"
